{
  "rewrites": [
    {
      "source": "/b1/superUsers/me/banners:path*",
      "destination": "https://api.basilium.ai.kr/b1/superUsers/me/banners:path*"
    }
  ],
  "headers": [
    {
      "source": "/img/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
